<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.hoodly.hoodlydesktop.controllers.DashboardController">

    <!-- SIDEBAR -->
    <left>
        <VBox styleClass="sidebar" spacing="8" prefWidth="220">
            <padding><Insets top="24" right="16" bottom="24" left="16"/></padding>

            <Label text="HOODLY" styleClass="sidebar-title"/>
            <Label fx:id="adminNameLabel" text="Chargement..." styleClass="sidebar-subtitle"/>

            <Separator style="-fx-padding: 8 0 8 0;"/>

            <Button text="Incidents" styleClass="sidebar-btn" maxWidth="Infinity"
                    onAction="#showIncidents"/>
            <Button text="Statistiques" styleClass="sidebar-btn" maxWidth="Infinity"
                    onAction="#showStats"/>
            <Button text="Plugins" styleClass="sidebar-btn" maxWidth="Infinity"
                    onAction="#showPlugins"/>
            <Button text="Paramètres" styleClass="sidebar-btn" maxWidth="Infinity"
                    onAction="#showSettings"/>

            <VBox VBox.vgrow="ALWAYS"/>

            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label fx:id="connectionStatus" text="● En ligne" styleClass="status-online"/>
            </HBox>

            <Button text="Se déconnecter" styleClass="btn-danger" maxWidth="Infinity"
                    onAction="#handleLogout"/>
        </VBox>
    </left>

    <!-- CONTENU PRINCIPAL -->
    <center>
        <StackPane>

            <!-- PANNEAU INCIDENTS -->
            <VBox fx:id="incidentsPane" styleClass="main-content" spacing="20">
                <padding><Insets top="32" right="32" bottom="32" left="32"/></padding>

                <Label fx:id="pageTitle" text="Tableau de bord" styleClass="page-title"/>

                <HBox spacing="16">
                    <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                        <Label text="Incidents ouverts" styleClass="stat-label"/>
                        <Label fx:id="openIncidentsCount" text="—" styleClass="stat-value"/>
                    </VBox>
                    <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                        <Label text="En cours" styleClass="stat-label"/>
                        <Label fx:id="inProgressCount" text="—" styleClass="stat-value"/>
                    </VBox>
                    <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                        <Label text="Résolus" styleClass="stat-label"/>
                        <Label fx:id="resolvedCount" text="—" styleClass="stat-value"/>
                    </VBox>
                    <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                        <Label text="Sync en attente" styleClass="stat-label"/>
                        <Label fx:id="syncPendingCount" text="0" styleClass="stat-value"/>
                    </VBox>
                </HBox>

                <Label text="Incidents récents" styleClass="section-title"/>
                <TableView fx:id="incidentsTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="typeCol" text="Type" prefWidth="120"/>
                        <TableColumn fx:id="descCol" text="Description" prefWidth="240"/>
                        <TableColumn fx:id="statutCol" text="Statut" prefWidth="110"/>
                        <TableColumn fx:id="prioriteCol" text="Priorité" prefWidth="90"/>
                        <TableColumn fx:id="dateCol" text="Date" prefWidth="140"/>
                        <TableColumn fx:id="actionsCol" text="Actions" prefWidth="180"/>
                    </columns>
                </TableView>
            </VBox>

            <!-- PANNEAU STATISTIQUES -->
            <VBox fx:id="statsPane" styleClass="main-content" spacing="20" visible="false" managed="false">
                <padding><Insets top="32" right="32" bottom="32" left="32"/></padding>

                <Label text="Statistiques de participation" styleClass="page-title"/>

                <HBox spacing="20" VBox.vgrow="ALWAYS">
                    <PieChart fx:id="statutChart" title="Répartition par statut"
                              HBox.hgrow="ALWAYS" maxHeight="320"/>
                    <BarChart fx:id="typeChart" title="Incidents par type"
                              HBox.hgrow="ALWAYS" maxHeight="320" legendVisible="false">
                        <xAxis><CategoryAxis label="Type"/></xAxis>
                        <yAxis><NumberAxis label="Nombre"/></yAxis>
                    </BarChart>
                </HBox>

                <Label text="Participation des voisins" styleClass="section-title"/>
                <BarChart fx:id="participationChart" VBox.vgrow="ALWAYS" maxHeight="280" legendVisible="false">
                    <xAxis><CategoryAxis label="Voisin"/></xAxis>
                    <yAxis><NumberAxis label="Incidents signalés"/></yAxis>
                </BarChart>
            </VBox>

            <!-- PANNEAU PARAMÈTRES -->
            <VBox fx:id="settingsPane" styleClass="main-content" spacing="24" visible="false" managed="false">
                <padding><Insets top="32" right="32" bottom="32" left="32"/></padding>

                <Label text="Paramètres" styleClass="page-title"/>

                <VBox styleClass="settings-card" spacing="12">
                    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                    <Label text="Thème" styleClass="settings-section-title"/>
                    <HBox spacing="16">
                        <RadioButton fx:id="themeBleu" text="Bleu"/>
                        <RadioButton fx:id="themeSombre" text="Sombre"/>
                        <RadioButton fx:id="themeVert" text="Vert"/>
                    </HBox>
                </VBox>

                <VBox styleClass="settings-card" spacing="12">
                    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                    <Label text="Taille de police" styleClass="settings-section-title"/>
                    <HBox spacing="16">
                        <RadioButton fx:id="fontSmall" text="Petite"/>
                        <RadioButton fx:id="fontNormal" text="Normale"/>
                        <RadioButton fx:id="fontLarge" text="Grande"/>
                    </HBox>
                </VBox>

                <VBox styleClass="settings-card" spacing="12">
                    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                    <Label text="Disposition" styleClass="settings-section-title"/>
                    <HBox spacing="16">
                        <RadioButton fx:id="layoutNormal" text="Normale"/>
                        <RadioButton fx:id="layoutCompact" text="Compacte"/>
                    </HBox>
                </VBox>

                <Button text="Appliquer" styleClass="btn-apply" onAction="#applySettings"
                        prefWidth="160" prefHeight="40"/>

                <VBox styleClass="settings-card" spacing="12">
                    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                    <Label text="Désinstaller l'application" styleClass="settings-section-title"/>
                    <Label text="Supprime toutes les données locales et le fichier .jar, puis ferme l'application." wrapText="true" styleClass="stat-label"/>
                    <Button text="Désinstaller" styleClass="btn-danger" onAction="#handleUninstall"
                            prefWidth="160" prefHeight="40"/>
                </VBox>

            </VBox>

            <!-- PANNEAU PLUGINS -->
            <VBox fx:id="pluginsPane" styleClass="main-content" spacing="24" visible="false" managed="false">
                <padding><Insets top="32" right="32" bottom="32" left="32"/></padding>
                <Label text="Plugins" styleClass="page-title"/>
                <HBox spacing="20">
                    <VBox styleClass="stat-card" spacing="12" HBox.hgrow="ALWAYS">
                        <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                        <Label text="Export statistiques" styleClass="section-title"/>
                        <Label text="Exporte les incidents de votre zone au format CSV." wrapText="true" styleClass="stat-label"/>
                        <Button text="Exporter CSV" styleClass="btn-apply" onAction="#exportCsv" prefWidth="140"/>
                    </VBox>
                    <VBox styleClass="stat-card" spacing="12" HBox.hgrow="ALWAYS">
                        <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                        <Label text="Analyse sociale" styleClass="section-title"/>
                        <Label text="Visualise la répartition des incidents par jour et par mois." wrapText="true" styleClass="stat-label"/>
                        <Button text="Ouvrir" styleClass="btn-apply" onAction="#showAnalyseSociale" prefWidth="140"/>
                    </VBox>
                    <VBox styleClass="stat-card" spacing="12" HBox.hgrow="ALWAYS">
                        <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                        <Label text="Calendrier local" styleClass="section-title"/>
                        <Label text="Affiche les incidents jour par jour sur le mois en cours." wrapText="true" styleClass="stat-label"/>
                        <Button text="Ouvrir" styleClass="btn-apply" onAction="#showCalendrier" prefWidth="140"/>
                    </VBox>
                </HBox>
            </VBox>

            <!-- PANNEAU ANALYSE SOCIALE -->
            <VBox fx:id="analysePane" styleClass="main-content" spacing="20" visible="false" managed="false">
                <padding><Insets top="32" right="32" bottom="32" left="32"/></padding>
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <Button text="← Plugins" styleClass="sidebar-btn" onAction="#showPlugins"/>
                    <Label text="Analyse sociale" styleClass="page-title"/>
                </HBox>
                <HBox spacing="20" VBox.vgrow="ALWAYS">
                    <BarChart fx:id="jourSemaineChart" title="Incidents par jour de la semaine"
                              HBox.hgrow="ALWAYS" maxHeight="300" legendVisible="false">
                        <xAxis><CategoryAxis/></xAxis>
                        <yAxis><NumberAxis/></yAxis>
                    </BarChart>
                    <BarChart fx:id="evolutionChart" title="Évolution sur 6 mois"
                              HBox.hgrow="ALWAYS" maxHeight="300" legendVisible="false">
                        <xAxis><CategoryAxis/></xAxis>
                        <yAxis><NumberAxis/></yAxis>
                    </BarChart>
                </HBox>
            </VBox>

            <!-- PANNEAU CALENDRIER -->
            <VBox fx:id="calendrierPane" styleClass="main-content" spacing="20" visible="false" managed="false">
                <padding><Insets top="32" right="32" bottom="32" left="32"/></padding>
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <Button text="← Plugins" styleClass="sidebar-btn" onAction="#showPlugins"/>
                    <Label fx:id="calendrierTitle" text="Calendrier" styleClass="page-title"/>
                </HBox>
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <Button text="◀" onAction="#prevMonth" prefWidth="36"/>
                    <Button text="▶" onAction="#nextMonth" prefWidth="36"/>
                </HBox>
                <GridPane fx:id="calendrierGrid" hgap="6" vgap="6"/>
            </VBox>

        </StackPane>
    </center>

</BorderPane>
